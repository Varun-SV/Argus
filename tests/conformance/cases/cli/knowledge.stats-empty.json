{
  "schema": "argus-conformance-case-v1",
  "id": "cli.knowledge.stats-empty",
  "title": "argus knowledge stats on a fresh project reports no knowledge",
  "requirements": [
    "C-02",
    "C-07",
    "PARITY-1"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "init"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "knowledge",
        "stats"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "regex": [
            "(?i)\\bno knowledge\\b"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
