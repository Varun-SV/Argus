{
  "schema": "argus-conformance-case-v1",
  "id": "cli.secrets.stdin-and-file-conflict",
  "title": "--stdin and --file together are a usage error",
  "requirements": [
    "C-06",
    "C-07"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "setup": {
    "files": [
      {
        "path": "value.txt",
        "content": "DUMMY-VALUE-TEST-ONLY-7f3a91"
      }
    ]
  },
  "steps": [
    {
      "args": [
        "secrets",
        "set",
        "secret://argus/conformance/token",
        "--stdin",
        "--file",
        "value.txt"
      ],
      "stdin": "DUMMY-VALUE-TEST-ONLY-7f3a91",
      "expect": {
        "exit": 2,
        "output": {
          "contains": [
            "--stdin",
            "--file"
          ],
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "list"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "secret://argus/conformance/token",
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
