{
  "schema": "argus-conformance-case-v1",
  "id": "cli.serve.non-loopback-needs-allow-remote",
  "title": "argus serve on a non-loopback host without --allow-remote exits non-zero naming the flag",
  "requirements": [
    "C-07",
    "R-3",
    "SEC-1",
    "PARITY-1"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "serve",
        "--host",
        "0.0.0.0",
        "--port",
        "59997"
      ],
      "timeout_s": 20,
      "expect": {
        "exit": "nonzero",
        "output": {
          "contains": [
            "--allow-remote"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ],
  "note": "Must fail before binding; a timeout here means the server started."
}
