{
  "schema": "argus-conformance-case-v1",
  "id": "cli.secrets.round-trip",
  "title": "argus secrets set/list/remove round trip never prints or stores the value in plaintext",
  "requirements": [
    "C-06",
    "C-07",
    "PARITY-1"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "secrets",
        "list"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "secret://argus/conformance/token",
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "set",
        "secret://argus/conformance/token",
        "--stdin"
      ],
      "stdin": "DUMMY-VALUE-TEST-ONLY-7f3a91",
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "list"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "contains": [
            "secret://argus/conformance/token"
          ],
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        },
        "files": [
          {
            "path": ".",
            "root": "sandbox",
            "tree_not_contains": [
              "DUMMY-VALUE-TEST-ONLY-7f3a91"
            ]
          }
        ]
      }
    },
    {
      "args": [
        "secrets",
        "remove",
        "secret://argus/conformance/token"
      ],
      "stdin": "y\n",
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "list"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "secret://argus/conformance/token",
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
