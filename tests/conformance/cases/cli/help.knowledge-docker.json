{
  "schema": "argus-conformance-case-v1",
  "id": "cli.help.knowledge-docker",
  "title": "argus knowledge docker --help exits 0 and documents its options",
  "requirements": [
    "C-07",
    "PARITY-1"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "knowledge",
        "docker",
        "--help"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "contains": [],
          "regex": [
            "(?i)\\busage\\b",
            "(?m)^\\s+up\\b",
            "(?m)^\\s+down\\b",
            "(?m)^\\s+status\\b"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
