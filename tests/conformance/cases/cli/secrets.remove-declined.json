{
  "schema": "argus-conformance-case-v1",
  "id": "cli.secrets.remove-declined",
  "title": "declining the removal prompt keeps the secret",
  "requirements": [
    "C-06",
    "C-07"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "secrets",
        "set",
        "secret://argus/conformance/token",
        "--stdin"
      ],
      "stdin": "DUMMY-VALUE-TEST-ONLY-7f3a91",
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "remove",
        "secret://argus/conformance/token"
      ],
      "stdin": "n\n",
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "list"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "contains": [
            "secret://argus/conformance/token"
          ],
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
