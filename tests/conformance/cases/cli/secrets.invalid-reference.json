{
  "schema": "argus-conformance-case-v1",
  "id": "cli.secrets.invalid-reference",
  "title": "argus secrets set rejects a reference outside secret://argus/ without storing it",
  "requirements": [
    "C-06",
    "C-07"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "secrets",
        "set",
        "not-a-reference",
        "--stdin"
      ],
      "stdin": "DUMMY-VALUE-TEST-ONLY-7f3a91",
      "expect": {
        "exit": 1,
        "output": {
          "regex": [
            "(?i)secret://argus/"
          ],
          "not_contains": [
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "secrets",
        "list"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "not_contains": [
            "not-a-reference",
            "DUMMY-VALUE-TEST-ONLY-7f3a91"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
