{
  "schema": "argus-conformance-case-v1",
  "id": "cli.unknown-command",
  "title": "an unknown command is a usage error (exit 2) that names it",
  "requirements": [
    "C-07"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "active"
    }
  },
  "steps": [
    {
      "args": [
        "no-such-command"
      ],
      "expect": {
        "exit": 2,
        "output": {
          "contains": [
            "no-such-command"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
