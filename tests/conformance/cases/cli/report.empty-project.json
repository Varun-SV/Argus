{
  "schema": "argus-conformance-case-v1",
  "id": "cli.report.empty-project",
  "title": "argus report on a project without runs says there are none",
  "requirements": [
    "C-07",
    "PARITY-1"
  ],
  "impls": {
    "python": {
      "status": "active"
    },
    "rust": {
      "status": "pending",
      "note": "argus-next implements only --help and --version in P0; commands arrive in later phases (spec section 12)"
    }
  },
  "steps": [
    {
      "args": [
        "init"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "report"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "regex": [
            "(?i)\\bno runs\\b"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    },
    {
      "args": [
        "report",
        "--limit",
        "3"
      ],
      "expect": {
        "exit": 0,
        "output": {
          "regex": [
            "(?i)\\bno runs\\b"
          ],
          "not_regex": [
            "Traceback \\(most recent call last\\)"
          ]
        }
      }
    }
  ]
}
